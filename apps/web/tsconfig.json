{
  "extends": "@repo/forge/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    ".storybook",
    "panda.config.ts",
    "vite.app.config.ts",
    "worker-configuration.d.ts",
    "routeTree.gen.ts",
    "styled-system"
  ]
}
