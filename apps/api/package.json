{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsrs --noEmit --fast",
    "db:migrate": "wrangler d1 migrations apply turbo-remote-cache --local",
    "db:migrate:remote": "wrangler d1 migrations apply turbo-remote-cache --remote"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:auth",
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@orpc/contract": "catalog:api",
    "@orpc/server": "catalog:api",
    "@repo/api-contract": "workspace:*",
    "@repo/db": "workspace:*",
    "better-auth": "catalog:auth",
    "drizzle-orm": "catalog:db",
    "hono": "catalog:api"
  },
  "devDependencies": {
    "@repo/forge": "workspace:*",
    "wrangler": "catalog:cloudflare"
  }
}
