{
  "name": "turborepo-remote-cache-server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "check": "pnpm run types && pnpm run generate && pnpm run typecheck && oxlint --type-aware && oxfmt -c oxfmt.config.ts --check && knip",
    "fix": "oxlint --type-aware --fix && oxfmt -c oxfmt.config.ts",
    "knip": "knip",
    "prepare": "lefthook install",
    "db:generate": "pnpm --filter @repo/db run generate",
    "db:migrate": "pnpm --filter @repo/api run db:migrate",
    "db:migrate:remote": "pnpm --filter @repo/api run db:migrate:remote",
    "types": "pnpm -r --if-present run types",
    "check:migrations": "./scripts/check-migrations.sh HEAD",
    "admin:setup": "pnpm --filter @repo/api run admin:setup",
    "test": "vitest run",
    "dev": "pnpm --filter @repo/web run dev",
    "build": "pnpm -r --if-present run build",
    "generate": "pnpm -r --if-present run generate",
    "deploy": "pnpm run deploy:api && pnpm run deploy:web",
    "deploy:api": "pnpm --filter @repo/api run deploy",
    "deploy:web": "pnpm --filter @repo/web run deploy",
    "storybook": "pnpm --filter @repo/web run storybook",
    "storybook:build": "pnpm --filter @repo/web run storybook:build",
    "e2e": "./e2e/run.sh",
    "spec:update": "pnpm --filter @repo/api-contract run spec:update"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:cloudflare",
    "@repo/forge": "workspace:*",
    "@tsconfig/strictest": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "knip": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "tsrs": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "ultracite": "catalog:tooling",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
