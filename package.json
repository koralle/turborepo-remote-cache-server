{
  "name": "turborepo-remote-cache-server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm run typecheck && oxlint --type-aware && oxfmt -c oxfmt.config.ts --check && knip",
    "fix": "oxlint --type-aware --fix && oxfmt -c oxfmt.config.ts",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "knip": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "tsrs": "catalog:tooling",
    "typescript": "catalog:tooling",
    "ultracite": "catalog:tooling"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
